{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md", "VISION.md"],
  "compaction": { "auto": true, "tail_turns": 15 },
  "mcp": {
    "tavily": {
      "type": "remote",
      "url": "https://mcp.tavily.com/mcp/?tavilyApiKey=PLACE TAVILY API KEY HERE",
      "enabled": true
    },
    "firecrawl": {
      "type": "remote",
      "url": "https://mcp.firecrawl.dev/mcp",
      "enabled": true,
      "headers": {
        "Authorization": "PLACE FIRECRAWL API KEY HERE"
      }
    },
    "open-websearch": {
      "type": "local",
      "command": ["cmd", "/c", "npx", "-y", "open-websearch@latest"],
      "enabled": true,
      "environment": {
        "MODE": "stdio",
        "DEFAULT_SEARCH_ENGINE": "duckduckgo",
        "ALLOWED_SEARCH_ENGINES": "duckduckgo,bing,brave,exa,startpage",
        "SYSTEMROOT": "C:/Windows"
      }
    },
    "duckduckgo": {
      "type": "local",
      "command": ["cmd", "/c", "python", "-m", "duckduckgo_mcp_server.server"],
      "enabled": true
    }
  }
}
