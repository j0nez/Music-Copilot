{
  "name": "music-copilot-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "src/main/main.js",
  "scripts": {
    "dev": "vite",
    "dev:electron": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && electron .\"",
